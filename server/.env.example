# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on (the client's VITE_API_URL must point here)
PORT=3030

# MongoDB connection string (local MongoDB or a MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017

# Database name inside MongoDB
DB_NAME=todo-notebook

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Which web addresses may call the API (comma separated)
CLIENT_ORIGIN=http://localhost:5173
